export async function updateOwnerUpgradeRequest(requestId, payload) {
  const response = await apiClient.put(
    `/auth/my-owner-upgrade-requests/${requestId}`,
    normalizeOwnerUpgradePayload(payload),
  );
  return response.data;
}

