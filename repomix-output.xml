      })),
    },
    {
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${import.meta.env.VITE_MISTRAL_API_KEY}`,
      },
    }
  );

  return response.data.choices[0]?.message?.content;
};
