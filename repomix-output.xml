/* ===== ADMIN DASHBOARD REDESIGN ===== */
.admin-page {
  min-height: 100vh;
  padding: 20px 20px 96px;
  background: #f5f7fb;
}

.admin-hero {
  display: none;
}

.admin-topbar {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  max-width: 1480px;
  margin: 0 auto 16px;
  padding: 18px 20px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  background:
    radial-gradient(circle at 18% 8%, rgba(255, 255, 255, 0.36), transparent 30%),
    radial-gradient(circle at 82% 0%, rgba(125, 211, 252, 0.34), transparent 28%),
    linear-gradient(135deg, #155eef 0%, #2563eb 46%, #0ea5e9 100%);
  border: 1px solid rgba(191, 219, 254, 0.7);
  border-radius: 8px;
  box-shadow: 0 16px 34px rgba(37, 99, 235, 0.2);
}

.admin-topbar::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(
    110deg,
    transparent 0%,
