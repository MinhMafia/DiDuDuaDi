  }

  .admin-panel {
    padding: 16px;
  }

  .admin-panel-header {
    flex-direction: column;
    gap: 12px;
  }

  .admin-cards-list {
    grid-template-columns: 1fr;
  }

  .admin-stats-grid {
    grid-template-columns: 1fr;
  }

