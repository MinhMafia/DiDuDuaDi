<file path="Đặc tả wed/activity_10_auto_play_tts.puml">
@startuml activity_10_auto_play_tts
skinparam backgroundColor White
skinparam activityFontSize 12
skinparam activityFontName "Times New Roman"

start

:User bat che do tu thuyet minh
khi o gan POI;

repeat
  :Trinh duyet cap nhat vi tri qua watchPosition;
  :Frontend tinh khoang cach Haversine
  den cac POI dang co tren ban do;

  if (Co POI trong pham vi 35m?) then (Khong)
    :Khong phat am thanh;
  else (Co)
    :Lay danh sach ung vien gan trong 35m;
    :Sap xep theo khoang cach tang dan;

    if (Nhieu POI co khoang cach gan bang nhau?) then (Co)
      if (Co POI chua tung nghe trong phien nay?) then (Co)
        :Chon POI chua nghe truoc;
      else (Khong)
        :Chon POI dau tien theo thu tu on dinh
        de tranh doi qua lai lien tuc;
      endif
    else (Khong)
      :Chon POI gan nhat;
    endif

    if (POI vua chon da duoc phat gan day?) then (Co)
      :Bo qua de tranh lap audio lien tuc;
    else (Khong)
      :Lay ngon ngu hien tai;
      if (Co audio dung ngon ngu?) then (Co)
        :Phat file audio dung ngon ngu;
      else (Khong)
        :Dung speechText va Web Speech API
        dung ngon ngu hien tai;
        :Khong dung audio tieng Viet thay the;
      endif
      :Danh dau POI da nghe trong phien;
      :Ghi nhan su kien audio-play;
    endif
  endif
repeat while (Ung dung con chay) is (Co)

stop

@enduml
</file>

<file path="Đặc tả wed/activity_11_user_upgrade_request.puml">
@startuml activity_11_user_upgrade_request
skinparam backgroundColor White
skinparam activityFontSize 12
skinparam activityFontName "Times New Roman"

start

:User truy cap trang Dang ky quan an;

:He thong hien thi giao dien Tabs;

if (User chon tab Lich su va Trang thai?) then (Co)
  :Lay danh sach don da gui cua user;
  :Hien thi trang thai:\npending / payment_pending / approved / rejected / cancelled\nva ly do tu choi neu co;

  if (Don dang cho thanh toan?) then (Co)
    :Hien thi QR thanh toan,\nma tham chieu va noi dung chuyen khoan;
  else (Khong)
    :Khong hien thi khoi thanh toan;
  endif

  if (Don cu bi tu choi?) then (Co)
    if (User chon sua lai tu don cu?) then (Co)
      :User bam "Sua lai tu don cu";
      :Nap thong tin don cu sang form dang ky moi;
    else (Khong)
      :User chi xem lich su;
      stop
    endif
  else (Khong)
    :User chi xem lich su;
    stop
  endif
else (Khong)
  :User chon tab Dang ky moi;
endif

:User dien thong tin:\n- Ten quan\n- Dia chi\n- Vi tri GPS chon truc tiep tren ban do\n- Anh CCCD/GPKD neu co\n- Ghi chu;

:He thong dong bo toa do tu map picker\nvao latitude/longitude;

:He thong kiem tra User da co yeu cau\npending hoac payment_pending?;

if (Da co don chua ket thuc?) then (Co)
  :Hien thi thong bao da co yeu cau dang cho duyet;
  stop
else (Khong)
  :Tao yeu cau owner upgrade moi;
  :Luu vao owner_upgrade_requests;
  :Hien thi thong bao thanh cong;
  :Cho Admin thay yeu cau trong Dashboard;
endif

stop

@enduml
</file>

<file path="Đặc tả wed/activity_12_admin_review_upgrade.puml">
@startuml activity_12_admin_review_upgrade
skinparam backgroundColor White
skinparam activityFontSize 12
skinparam activityFontName "Times New Roman"

start

:Admin truy cap dashboard;

:He thong lay danh sach yeu cau
  co trang thai "pending";

:Admin chon mot yeu cau de xem;

:Hien thi chi tiet yeu cau:
- Username, display_name
- Ten shop, dia chi
- Hinh giay to (neu co)
- Ghi chu;

:Admin quyet dinh;

if (Phe duyet?) then (Phe duyet)
  :He thong tao ma tham chieu
  va QR thanh toan nang quyen;
  :Cap nhat trang thai yeu cau thanh
  "payment_pending";
  :Thong bao cho User hoan tat thanh toan;

  if (Admin xac nhan da thanh toan?) then (Da thanh toan)
    :He thong nang role cua user thanh "owner";
    :He thong tao/cap nhat shop va POI mac dinh
    voi thong tin tu yeu cau;
    :Cap nhat trang thai yeu cau thanh "approved";
    :Ghi payment_confirmed_at va activated_at;
    :Thong bao cho User;
  else (Huy QR thanh toan)
    :Xoa thong tin QR thanh toan;
    :Dua yeu cau ve "pending";
  endif
else (Tu choi)
  :Admin nhap ly do tu choi;
  :Cap nhat trang thai yeu cau thanh "rejected";
  :Luu ly do vao review_note;
  :Thong bao cho User kem ly do;
endif

stop

@enduml
</file>

<file path="Đặc tả wed/activity_13_admin_review_shop_intro.puml">
@startuml activity_13_admin_review_shop_intro
skinparam backgroundColor White
skinparam activityFontSize 12
skinparam activityFontName "Times New Roman"

start

:Owner cap nhat pending_intro cho shop;

:He thong dat intro_review_status thanh "pending";

:Admin truy cap danh sach shop intro can duy;

:Admin chon mot shop de xem chi tiet;

:Hien thi thong tin shop:
- Ten shop, dia chi
- Approved introduction (hien tai)
- Pending introduction (moi);

:Admin quyet dinh;

if (Phe duyet?) then (Phe duyet)
