      window.print();
      return;
    }

    const styles = Array.from(
      document.querySelectorAll("style, link[rel='stylesheet']"),
    )
      .map((node) => node.outerHTML)
      .join("");

    printWindow.document.write(`
      <!doctype html>
      <html>
        <head>
          <title>DiDuDuaDi Standee</title>
          ${styles}
          <style>
            @page { size: A4 portrait; margin: 10mm; }
            html,
            body {
