export const askMistral = async (messages) => {
  const response = await axios.post(
    "https://api.mistral.ai/v1/chat/completions",
    {
      model: "mistral-medium-latest",
      messages: messages.map((msg) => ({
        role: msg.role === "assistant" ? "assistant" : "user",
