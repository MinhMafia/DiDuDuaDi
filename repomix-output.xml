<file path="frontend/src/components/auth/AuthShell.css">
.auth-page {
  --auth-ink: #1f2937;
  --auth-muted: #64748b;
  --auth-line: #dbe4ee;
  --auth-orange: #ff6b35;
  --auth-orange-deep: #ea580c;
  --auth-green: #0f766e;
  --auth-green-soft: #dffaf3;
  min-height: 100vh;
  display: grid;
  place-items: center;
  position: relative;
  overflow: hidden;
  padding: 26px;
  background:
    linear-gradient(120deg, rgba(255, 107, 53, 0.18), transparent 28%),
    linear-gradient(300deg, rgba(15, 118, 110, 0.18), transparent 26%),
    #f8fbf8;
  color: var(--auth-ink);
  font-family:
    "Segoe UI",
    "Noto Sans",
    "Helvetica Neue",
    Arial,
    sans-serif;
}

.auth-shell {
  position: relative;
  z-index: 1;
  width: min(1120px, 100%);
  display: grid;
  grid-template-columns: minmax(340px, 0.96fr) minmax(380px, 1fr);
  overflow: hidden;
  border-radius: 34px;
  background: rgba(255, 255, 255, 0.94);
  border: 1px solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 36px 90px rgba(31, 41, 55, 0.16);
}

.auth-showcase {
  min-height: 700px;
  padding: 34px;
  display: flex;
  align-items: center;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.42), rgba(255, 255, 255, 0.16)),
    linear-gradient(145deg, #f8eadc 0%, #eef6f0 100%);
}

.auth-showcase__content {
  width: 100%;
  display: grid;
  gap: 24px;
}

.auth-showcase__content h2 {
  margin: 0;
  max-width: 11ch;
  color: #1f2937;
  font-size: clamp(2.1rem, 4.2vw, 4.25rem);
  line-height: 1.04;
  font-weight: 850;
  letter-spacing: 0;
}

.auth-showcase__media {
  min-height: 380px;
  border-radius: 28px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.82);
  box-shadow: 0 26px 54px rgba(31, 41, 55, 0.14);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(15, 118, 110, 0.16)),
    url("https://tile.openstreetmap.org/15/26095/14857.png");
  background-size: cover;
  background-position: center;
  position: relative;
}

.auth-showcase__media::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, transparent 0 49%, rgba(255, 255, 255, 0.72) 49% 51%, transparent 51%),
