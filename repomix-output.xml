<file path="Đặc tả wed/activity_05_user_register.puml">
@startuml activity_05_user_register
skinparam backgroundColor White
skinparam activityFontSize 12
skinparam activityFontName "Times New Roman"

start

:User truy cap trang dang ky;

:User nhap username;
:User nhap password;
:User nhap display_name;
:User nhap email (tuy chon);

:He thong kiem tra tinh hop le cua du lieu;

if (Du lieu hop le?) then (Khong)
  :Hien thi thong bao loi;
  stop
else (Co)
  :Ma hoa password;
  :Tao tai khoan moi voi role "user";
  :Luu vao bang accounts;
  :Hien thi thong bao thanh cong;
  :Chuyen den trang dang nhap;
endif

stop

@enduml
</file>

<file path="Đặc tả wed/activity_06_user_login.puml">
@startuml activity_06_user_login
skinparam backgroundColor White
skinparam activityFontSize 12
skinparam activityFontName "Times New Roman"

start

:User truy cap trang dang nhap;

:User nhap username;
:User nhap password;

:He thong truy van bang accounts;

if (Tim thay tai khoan?) then (Khong)
  :Hien thi thong bao sai thong tin;
  stop
else (Co)
  if (Password dung?) then (Sai)
    :Hien thi thong bao sai mat khau;
    stop
  else (Dung)
    :Cap nhat last_login_at;
    :Sinh JWT token (sub, username, role, display_name);
    :Tra ve session cho client;
    :Chuyen den trang chuc nang theo role;
    stop
  endif
endif

@enduml
</file>

<file path="Đặc tả wed/activity_07_user_discover_poi.puml">
@startuml activity_07_user_discover_poi
skinparam backgroundColor White
skinparam activityFontSize 12
skinparam activityFontName "Times New Roman"

start

:User mo ung dung / trang ban do;

:He thong yeu cau quyen truy cap GPS;

if (User cap GPS?) then (Tu choi)
  :Hien thi ban do voi vi tri mac dinh;
else (Cap quyen)
  :He thong lay vi tri hien tai tu GPS;
endif

:He thong truy van GetNearby POI (ban kinh tuy chon);

:Ban do hien thi cac POI gan nhat;

:User dieu chinh thanh truot radius;

:He thong cap nhat danh sach POI theo ban kinh moi;

:User chon mot POI tren ban do;

:Chuyen den luong xem chi tiet POI;

stop

@enduml
</file>

<file path="Đặc tả wed/activity_08_user_view_poi_detail.puml">
@startuml activity_08_user_view_poi_detail
skinparam backgroundColor White
skinparam activityFontSize 12
skinparam activityFontName "Times New Roman"

start

:User mo chi tiet POI tu ban do,
danh sach gan ban hoac link QR cong khai;

if (URL co source=qr?) then (Co)
  :Danh dau nguon truy cap la QR;
else (Khong)
  :Danh dau nguon la map hoac public-detail;
endif

:Frontend goi API lay chi tiet POI;

:He thong truy van POI, ban dich,
thong tin shop va thuc don dang hien;

:Hien thi trang chi tiet:
- Anh dai dien
- Ten quan, dia chi, toa do
- Mo ta theo ngon ngu dang chon
- Thuc don dang hien
- Audio guide
- Link/QR chia se;

:Ghi nhan su kien xem POI vao analytics
voi poiId, languageCode, source;

:User chon ngon ngu;

:He thong lay noi dung theo ngon ngu tu ban dich;

if (User nghe thuyet minh?) then (Co)
  if (Co audio dung ngon ngu dang chon?) then (Co)
    :Phat file audio dung ngon ngu;
  else (Khong)
    :Dung speechText va Web Speech API
    theo dung ngon ngu dang chon;
    :Khong fallback sang audio tieng Viet;
  endif
  :Cho phep Play/Pause, tua, lui 5s
  neu dang phat file audio;
  :Ghi nhan audio_play_events;
else (Khong)
  :Chi hien thi van ban thuyet minh;
endif

:User co the mo ban do/tim duong
hoac quay lai danh sach;

stop

@enduml
</file>

