<file path="frontend/src/pages/CollaborationPage.css">
.collaboration-page {
  display: grid;
  gap: 16px;
  max-width: 980px;
  margin: 0 auto;
}

.collaboration-page-shell {
  max-width: 800px;
  margin: 0 auto;
  padding: 24px;
}

.collaboration-tabs .ant-tabs-nav {
  margin-bottom: 24px;
}

.collaboration-tabs .ant-tabs-tab {
  padding: 12px 16px;
  font-weight: 600;
}

.collaboration-tabs .ant-tabs-content-holder {
  min-height: 360px;
}

.collaboration-map-picker {
  display: grid;
  gap: 12px;
}

.collaboration-map-picker-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.collaboration-map-canvas {
  border: 1px solid #dbe3ef;
  border-radius: 8px;
  overflow: hidden;
  background: #f8fafc;
  height: 320px;
  min-height: 0;
  position: relative;
  isolation: isolate;
}

.collaboration-map-leaflet {
  width: 100%;
  height: 100%;
  min-height: 0;
  display: block;
  border-radius: inherit;
}

.collaboration-map-canvas .leaflet-container {
  width: 100%;
  height: 100%;
  min-height: 0;
}

.collaboration-map-canvas .leaflet-control-container {
  position: relative;
  z-index: 400;
}

.collaboration-map-canvas .leaflet-control-attribution {
  max-width: calc(100% - 72px);
  white-space: normal;
  line-height: 1.25;
}

.collaboration-card {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  padding: 18px;
}

.collaboration-form {
  display: grid;
  gap: 12px;
}

.collaboration-form-row {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.collaboration-label {
  display: grid;
  gap: 6px;
  font-weight: 600;
}

.collaboration-input {
  border: 1px solid #cbd5e1;
  border-radius: 12px;
  padding: 12px 14px;
  outline: none;
  width: 100%;
  min-height: 46px;
  font: inherit;
}

.collaboration-input:focus {
  border-color: #0f766e;
  box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.12);
}

.collaboration-textarea {
  resize: vertical;
  min-height: 96px;
}

.collaboration-submit {
  border: none;
  border-radius: 14px;
  background: #0f766e;
  color: #fff;
  padding: 13px 16px;
  font-weight: 700;
  cursor: pointer;
  min-height: 48px;
}

.collaboration-submit:disabled {
  cursor: not-allowed;
  opacity: 0.7;
}

.collaboration-status-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 16px;
  flex-wrap: wrap;
}

.collaboration-status-badge {
  border-radius: 999px;
  padding: 8px 12px;
  font-weight: 800;
  font-size: 13px;
  max-width: 100%;
}

.collaboration-info-text {
  margin: 0 0 14px;
  color: #334155;
}

.collaboration-notice {
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  padding: 16px;
  background: #f8fafc;
}

.collaboration-rejected {
  border: 1px solid #fecaca;
  border-radius: 14px;
  padding: 16px;
  background: #fff1f2;
  margin-top: 14px;
}

.collaboration-payment-layout {
  display: grid;
  gap: 16px;
  grid-template-columns: minmax(0, 1.2fr) minmax(260px, 320px);
  align-items: start;
}

.collaboration-detail-grid {
  display: grid;
  gap: 10px;
  margin-top: 16px;
}

.collaboration-detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 12px;
  background: #fff;
  border: 1px solid #e2e8f0;
  flex-wrap: wrap;
}

.collaboration-detail-label {
  color: #64748b;
}

.collaboration-detail-value {
  text-align: right;
  overflow-wrap: anywhere;
}

.collaboration-qr-panel {
  display: grid;
  gap: 12px;
  border: 1px solid #dbeafe;
  border-radius: 16px;
  padding: 16px;
  background: #eff6ff;
  justify-items: center;
  align-content: start;
}

.collaboration-qr-title {
  font-size: 16px;
}

.collaboration-qr-image {
  width: 100%;
  max-width: 260px;
  border-radius: 12px;
  background: #fff;
  padding: 10px;
  border: 1px solid #bfdbfe;
}

.collaboration-qr-content {
  margin-top: 16px;
  display: grid;
  gap: 8px;
}

.collaboration-code {
  display: block;
  white-space: pre-wrap;
  padding: 12px;
  border-radius: 12px;
  background: #0f172a;
  color: #f8fafc;
  word-break: break-word;
}

.collaboration-history-collapse {
  background: transparent;
}

.collaboration-history-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  width: 100%;
  flex-wrap: wrap;
}

.collaboration-history-subtitle {
  margin-top: 4px;
  color: #64748b;
  font-size: 13px;
}

.collaboration-history-body {
  display: grid;
  gap: 16px;
}

.collaboration-history-descriptions .ant-descriptions-item-label {
  width: 220px;
}

.collaboration-history-links {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.collaboration-history-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38px;
  padding: 8px 14px;
  border-radius: 999px;
  border: 1px solid #bfdbfe;
  background: #eff6ff;
  color: #1d4ed8;
  font-weight: 600;
  text-decoration: none;
}

.collaboration-history-link:hover {
  background: #dbeafe;
  color: #1e40af;
}

.collaboration-history-links .ant-btn {
  border-radius: 999px;
  font-weight: 600;
}

@media (max-width: 768px) {
  .collaboration-page {
    gap: 12px;
  }

  .collaboration-page-shell {
    padding: 16px;
  }

  .collaboration-tabs .ant-tabs-tab {
    padding: 10px 12px;
  }

  .collaboration-map-canvas {
    height: 280px;
  }

  .collaboration-card {
    padding: 14px;
    border-radius: 16px;
  }

  .collaboration-payment-layout {
