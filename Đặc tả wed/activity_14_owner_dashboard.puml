@startuml activity_14_owner_dashboard
skinparam backgroundColor White
skinparam activityFontSize 12
skinparam activityFontName "Times New Roman"

start

:Owner dang nhap he thong;

:Owner truy cap trang Owner dashboard;

:He thong lay dashboard theo owner hien tai:
- Shop profile
- POI chinh
- Ban dich POI
- Menu items
- Thong ke views/audio/QR;

:Hien thi sidebar gom:
- Tong quan
- Quan ly thuc don
- Thong tin quan
- Thong tin tren ban do
- QR quan;

if (Owner xem Tong quan?) then (Co)
  :Hien thi stat cards:
  mon dang co, luot xem, audio plays,
  luot quet QR va bieu do mini;
elseif (Owner quan ly thuc don?) then (Co)
  :Hien thi "Thuc don hien tai";
  :Owner bam Them mon hoac Sua;
  :Mo dialog them/sua mon;
  if (Luu mon?) then (Co)
    :Tao/cap nhat menu_items;
  elseif (Doi trang thai hien/het?) then (Co)
    :Cap nhat is_available;
  else (Xoa)
    :Xoa menu item;
  endif
elseif (Owner cap nhat thong tin quan?) then (Co)
  :Sua ten, mo ta, anh, danh muc;
  :Luu shop profile;
elseif (Owner cap nhat ban do?) then (Co)
  :Chon vi tri tren map picker
  hoac nhap toa do;
  :Cap nhat dia chi/toa do GPS;
elseif (Owner cap nhat noi dung da ngon ngu?) then (Co)
  :Sua ten/mo ta VI va EN;
  :He thong dich cac ngon ngu con lai;
  :Sinh audio/TTS cho ban dich neu co mo ta;
  :Cap nhat pois va poi_translations;
elseif (Owner xem QR quan?) then (Co)
  :Hien thi standee Digital Menu;
  :Sao chep link, mo trang chi tiet
  hoac in standee;
  :Link QR co source=qr de thong ke quet QR;
endif

:Refresh dashboard va thong ke moi;

stop

@enduml
