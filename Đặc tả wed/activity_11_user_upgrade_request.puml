@startuml activity_11_user_upgrade_request
skinparam backgroundColor White
skinparam activityFontSize 12
skinparam activityFontName "Times New Roman"

start

:User truy cap trang Dang ky quan an;

:He thong hien thi giao dien Tabs;

if (User chon tab Lich su va Trang thai?) then (Co)
  :Lay danh sach don da gui cua user;
  :Hien thi trang thai:\npending / payment_pending / approved / rejected / cancelled\nva ly do tu choi neu co;

  if (Don dang cho thanh toan?) then (Co)
    :Hien thi QR thanh toan,\nma tham chieu va noi dung chuyen khoan;
  else (Khong)
    :Khong hien thi khoi thanh toan;
  endif

  if (Don cu bi tu choi?) then (Co)
    if (User chon sua lai tu don cu?) then (Co)
      :User bam "Sua lai tu don cu";
      :Nap thong tin don cu sang form dang ky moi;
    else (Khong)
      :User chi xem lich su;
      stop
    endif
  else (Khong)
    :User chi xem lich su;
    stop
  endif
else (Khong)
  :User chon tab Dang ky moi;
endif

:User dien thong tin:\n- Ten quan\n- Dia chi\n- Vi tri GPS chon truc tiep tren ban do\n- Anh CCCD/GPKD neu co\n- Ghi chu;

:He thong dong bo toa do tu map picker\nvao latitude/longitude;

:He thong kiem tra User da co yeu cau\npending hoac payment_pending?;

if (Da co don chua ket thuc?) then (Co)
  :Hien thi thong bao da co yeu cau dang cho duyet;
  stop
else (Khong)
  :Tao yeu cau owner upgrade moi;
  :Luu vao owner_upgrade_requests;
  :Hien thi thong bao thanh cong;
  :Cho Admin thay yeu cau trong Dashboard;
endif

stop

@enduml
