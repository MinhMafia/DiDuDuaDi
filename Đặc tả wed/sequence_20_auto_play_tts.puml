@startuml sequence_20_auto_play_tts
skinparam backgroundColor White
skinparam sequenceFontSize 11
skinparam sequenceFontName "Times New Roman"
skinparam lifelineStrategy nosolid

actor User
participant "Frontend\n(MapPage)" as FE
participant "Browser\nGeolocation" as GPS
participant "Redux Store" as Store
participant "HTMLAudioElement\n/Web Speech API" as Audio
participant "AnalyticsController" as Ctrl
database "MySQL\naudio_play_events" as DB

User -> FE: Bat "Tu thuyet minh khi o gan POI"
FE -> GPS: watchPosition()

loop Khi vi tri thay doi
  GPS --> FE: { lat, lng }
  FE -> Store: Lay languageCode va danh sach POI
  Store --> FE: languageCode, pois
  FE -> FE: Tinh khoang cach tung POI
  FE -> FE: Lay cac POI trong 35m

  alt Khong co POI gan
    FE --> User: Khong phat audio
  else Co POI gan
    FE -> FE: Chon POI gan nhat;\nneu bang nhau uu tien POI chua nghe
    FE -> FE: Neu van bang nhau dung thu tu on dinh
    FE -> FE: Bo qua neu POI da phat gan day

    alt Co audioUrl dung languageCode
      FE -> Audio: play(audioUrl)
    else Khong co audio dung ngon ngu
      FE -> Audio: speechSynthesis.speak(speechText, languageCode)
      note right
        Khong fallback sang audio tieng Viet
        khi user dang chon ngon ngu khac.
      end note
    end

    FE -> Ctrl: POST /api/analytics/audio-play\n{ poiId, languageCode, source }
    Ctrl -> DB: INSERT audio_play_events
    DB --> Ctrl: OK
    Ctrl --> FE: 200 OK
  end
end

@enduml
