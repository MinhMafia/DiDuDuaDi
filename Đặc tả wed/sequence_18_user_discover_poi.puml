@startuml sequence_18_user_discover_poi
skinparam backgroundColor White
skinparam sequenceFontSize 11
skinparam sequenceFontName "Times New Roman"
skinparam lifelineStrategy nosolid

actor User
participant "Frontend\n(MapPage)" as FE
participant "Browser\nGeolocation" as GPS
participant "POIsController" as Ctrl
participant "MySqlPoiRepository" as Repo
database "MySQL\npois, poi_translations" as DB

User -> FE: Mo trang /map
FE -> GPS: watchPosition()\nhoac dung vi tri demo
GPS --> FE: { latitude, longitude }

FE -> Ctrl: GET /api/pois
Ctrl -> Repo: GetAll()
Repo -> DB: SELECT pois + translations
DB --> Repo: Danh sach POI
Repo --> Ctrl: List<POI>
Ctrl --> FE: 200 OK

FE -> FE: Tinh khoang cach Haversine\ncho tung POI
FE -> FE: Loc theo ban kinh chon\n50/100/200/500 hoac Tat ca
FE -> FE: Sap xep POI gan truoc
FE --> User: Hien thi marker, danh sach gan ban\nva ghi chu toa do duoi ban do

User -> FE: Doi ban kinh trong o chon co dinh
FE -> FE: Loc lai danh sach tren client
FE --> User: Cap nhat marker va danh sach

User -> FE: Click POI marker hoac card
FE -> Ctrl: GET /api/pois/{id}
Ctrl -> Repo: GetById(id)
Repo -> DB: SELECT POI chi tiet,\ntranslations, menu items
DB --> Repo: POI detail
Repo --> Ctrl: POI detail
Ctrl --> FE: 200 OK
FE --> User: Hien thi chi tiet nhanh\nva audio guide

@enduml
